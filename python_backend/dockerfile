FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    dos2unix \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /tmp/uploads /tmp/images /tmp/audio

# Ensure start.sh exists and is executable
RUN if [ ! -f start.sh ]; then \
        echo "Error: start.sh not found during build" && exit 1; \
    fi && \
    dos2unix start.sh 2>/dev/null || sed -i 's/\r$//' start.sh && \
    chmod +x start.sh && \
    echo "✓ start.sh is ready"

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Use bash to run start script
# Fix line endings at runtime in case volume mount overwrites them (Windows CRLF -> Linux LF)
# Use absolute path and ensure script is executable
CMD ["/bin/bash", "-c", "cd /app && [ -f start.sh ] && (dos2unix start.sh 2>/dev/null || sed -i 's/\\r$//' start.sh) && chmod +x start.sh && exec /bin/bash start.sh || (echo 'Error: start.sh not found in /app' && ls -la /app && exit 1)"]
