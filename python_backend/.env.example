# =============================================================================
# Stud AI Backend — Environment variables template
# =============================================================================
# Copy to `.env` in this directory (python_backend/) and fill in real values.
# Required for startup: SUPABASE_URL, SERVICE_ROLE_KEY, SECRET_KEY
# At least one AI key: GOOGLE_API_KEY and/or OPENAI_API_KEY
# =============================================================================

# -----------------------------------------------------------------------------
# Required — Database (Supabase)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Anon/public key (if used by client integrations)
SUPABASE_KEY=your_supabase_anon_key
# Service role key — backend reads this as SERVICE_ROLE_KEY (not SUPABASE_SERVICE_ROLE_KEY)
SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_ENGINE=supabase

# -----------------------------------------------------------------------------
# Required — Security / JWT
# -----------------------------------------------------------------------------
# Generate a long random string (e.g. openssl rand -hex 32)
SECRET_KEY=your_jwt_secret_key

# -----------------------------------------------------------------------------
# Required — AI provider API keys (at least one)
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key
OPENAI_API_KEY=your_openai_api_key

# -----------------------------------------------------------------------------
# AI agent model names (Gemini examples; use gpt-* / claude-* if preferred)
# -----------------------------------------------------------------------------
GAME_MASTER_MODEL_NAME=gemini-2.0-flash-exp
NPC_MODEL_NAME=gemini-2.0-flash-exp
DICE_MODEL_NAME=gemini-2.0-flash-exp
RAG_MODEL_NAME=gemini-2.0-flash-exp
STATE_CONTROLLER_MODEL_NAME=gemini-2.0-flash-exp
QUIZ_MODEL_NAME=gemini-2.0-flash-exp
# Note: config reads GAME_WORLD_MODEL_MODEL_NAME (typo preserved in code)
GAME_WORLD_MODEL_MODEL_NAME=gemini-2.0-flash-exp

# Optional legacy helper in model.py (used by some standalone agent utilities)
MODEL_NAME=gemini-2.0-flash-exp
MODEL_API_KEY=your_google_or_openai_api_key

# -----------------------------------------------------------------------------
# Optional — Web search (Serper)
# -----------------------------------------------------------------------------
SERPER_API_KEY=your_serper_api_key

# -----------------------------------------------------------------------------
# Redis (recommended for caching, chat memory, document-game job queue)
# -----------------------------------------------------------------------------
# Prefer REDIS_URL; if unset, built from REDIS_HOST/PORT/PASSWORD/USERNAME
# Docker Compose: redis://redis:6379 — backend on host only: redis://localhost:6379
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_MAX_CONNECTIONS=200
REDIS_POOL_SIZE=10
REDIS_POOL_MAX_CONNECTIONS=20

# -----------------------------------------------------------------------------
# Pinecone — document RAG / vector search (Study mode)
# -----------------------------------------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_REGION=us-east-1
PINECONE_INDEX_EXPIRATION_HOURS=2

# -----------------------------------------------------------------------------
# S3 — persistent uploads (optional; separate from USE_S3_STORAGE flag in config)
# -----------------------------------------------------------------------------
S3_ENABLED=false
S3_BUCKET_NAME=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
USE_S3_STORAGE=false

# -----------------------------------------------------------------------------
# File storage & upload limits
# -----------------------------------------------------------------------------
UPLOAD_FOLDER=./tmp/uploads
IMAGE_TEMP_DIR=./tmp/images
MAX_FILE_SIZE=10485760
MAX_IMAGE_SIZE=5242880

# -----------------------------------------------------------------------------
# Application & game settings
# -----------------------------------------------------------------------------
GAME_MASTER_NAME=Dr. Aegis
N_CHAT_SESSIONS=3
CONFIDENCE_SCORE_THRESHOLD=0.5
AI_CHAT_ID=
MAX_TOKENS=128000
AGENT_RESULT_RETRIES=5

# -----------------------------------------------------------------------------
# Chat memory & history
# -----------------------------------------------------------------------------
CHAT_MEMORY_EXPIRE_SECONDS=86400
CHAT_HISTORY_WINDOW=200
MAX_ACTIVE_CHAT_MESSAGES=100

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
ENABLE_ANALYTICS=true
ANALYTICS_FLUSH_INTERVAL=3600

# -----------------------------------------------------------------------------
# Database connection pool (Supabase via thread pool)
# -----------------------------------------------------------------------------
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_INCREMENT=2
DB_MAX_CONNECTIONS=20
DB_POOL_SIZE=10
DB_THREAD_POOL_SIZE=512

# -----------------------------------------------------------------------------
# Agent & model timeouts (seconds)
# -----------------------------------------------------------------------------
AGENT_TIMEOUT=60.0
AGENT_SPECIFIC_TIMEOUT=55.0
MODEL_TIMEOUT=30.0

# -----------------------------------------------------------------------------
# Document processing & document-based Mediquest jobs
# -----------------------------------------------------------------------------
DOCUMENT_CHUNK_WORDS=1000
DOCUMENT_CHUNK_OVERLAP=200
MAX_EXTRACTED_WORDS=200000
DOCUMENT_GAME_MAX_CASES=20
DOCUMENT_GAME_RELEVANCE_THRESHOLD=0.35
DOCUMENT_GAME_MAX_REFINE_TOOL_ROUNDS=8
DOCUMENT_GAME_JOB_REDIS_TTL=604800
DOCUMENT_GAME_LLM_BUDGET_UNITS=500000
DOCUMENT_GAME_QUEUE_KEY=jobs:document_game
DOCUMENT_GAME_JOBS_IN_REDIS=1
DOCUMENT_GAME_JOB_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Server, CORS & production
# -----------------------------------------------------------------------------
# Development: leave PRODUCTION unset; CORS defaults to *
# Production: set PRODUCTION=1 and comma-separated frontend origins
PRODUCTION=
REQUIRE_EXPLICIT_CORS=
ALLOWED_ORIGINS=http://localhost:3000

# Dev only — return password-reset token in API response (never in production)
EXPOSE_PASSWORD_RESET_TOKEN=0

# -----------------------------------------------------------------------------
# Process manager (start.sh / Docker production)
# -----------------------------------------------------------------------------
# Set GUNICORN_WORKERS=4 to use Gunicorn instead of uvicorn --reload
GUNICORN_WORKERS=
GUNICORN_TIMEOUT=120
