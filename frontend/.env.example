# Copy to .env.local for local dev, or use as reference for Docker / Vercel env vars.

# Supabase (required for auth; baked into client bundle at Docker build time)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Python API — runtime for Next.js API routes (Docker: host backend or stud-backend service)
PYTHON_BACKEND_URL=http://localhost:8000

# Optional
COOKIE_SECURE=false
