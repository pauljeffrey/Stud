# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
PYTHON_BACKEND_URL=http://localhost:8000

# API Key Requirement
# Set to "true" to allow users to use platform without providing their own API key
# Set to "false" to require users to provide API key before using platform (except demo)
NEXT_PUBLIC_USE_API_KEY=true
USE_API_KEY=true
